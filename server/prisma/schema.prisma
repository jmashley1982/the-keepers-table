generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Auth ───────────────────────────────────────────────────────────────────

model User {
  id              String   @id @default(cuid())
  email           String   @unique
  passwordHash    String?
  displayName     String
  avatarUrl       String?
  themePreference String   @default("system")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  credentials      ApiCredential[]
  preference       UserPreference?
  campaigns        Campaign[]
  generationJobs   GenerationJob[]
  customGenerators CustomGenerator[]
  systemTemplates  SystemTemplate[]  @relation("UserTemplates")
  artStylePresets  ArtStylePreset[]
}

// ─── API credentials ────────────────────────────────────────────────────────

model ApiCredential {
  id                  String    @id @default(cuid())
  userId              String
  provider            String    // "anthropic" | "evolink" | "spotify"
  encryptedKey        String?
  oauthAccessToken    String?
  oauthRefreshToken   String?
  oauthExpiresAt      DateTime?
  status              String    @default("unchecked") // "valid" | "invalid" | "unchecked"
  lastValidatedAt     DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
}

// ─── User preferences ───────────────────────────────────────────────────────

model UserPreference {
  id                   String   @id @default(cuid())
  userId               String   @unique
  defaultTextModel     String   @default("claude-sonnet-4-5")
  defaultImageModel    String   @default("seedream-5")
  imageStylePreset     String   @default("Classic fantasy oil")
  imageModelByCategory Json     @default("{}")
  contentRating        String   @default("standard") // "family" | "standard" | "grim"
  measurementUnits     String   @default("imperial")
  softCapPerCall       Float    @default(0.50)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── System templates ───────────────────────────────────────────────────────

model SystemTemplate {
  id                  String    @id @default(cuid())
  ownerUserId         String?
  name                String
  description         String    @default("")
  isBuiltin           Boolean   @default(false)
  statBlockSchema     Json      @default("[]")
  difficultyModel     Json      @default("{}")
  currencyAndRarity   Json      @default("{}")
  promptAddendum      String    @default("")
  customEntityFields  Json      @default("[]")
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  owner     User?      @relation("UserTemplates", fields: [ownerUserId], references: [id], onDelete: SetNull)
  campaigns Campaign[]
}

// ─── Campaigns ──────────────────────────────────────────────────────────────

model Campaign {
  id               String    @id @default(cuid())
  name             String
  ownerUserId      String
  systemTemplateId String
  settingNotes     String    @default("")
  bannerImageUrl   String?
  themeId          String?
  archived         Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  owner          User           @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  systemTemplate SystemTemplate @relation(fields: [systemTemplateId], references: [id])
  parties        Party[]
  sessions       GameSession[]
  npcs           NPC[]
  items          Item[]
  locations      Location[]
  factions       Faction[]
  encounters     Encounter[]
  plotThreads    PlotThread[]
  relationships  EntityRelationship[]
  mapAssets      MapAsset[]
  generationJobs   GenerationJob[]
  assets           Asset[]
  playerCharacters PlayerCharacter[]
}

// ─── Parties ────────────────────────────────────────────────────────────────

model Party {
  id                String    @id @default(cuid())
  campaignId        String
  name              String
  characters        Json      @default("[]")
  currentLocationId String?
  activeConditions  String    @default("")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  campaign    Campaign    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  sessions    GameSession[]
}

// ─── Sessions ───────────────────────────────────────────────────────────────

model GameSession {
  id                    String    @id @default(cuid())
  campaignId            String
  partyId               String?
  sessionNumber         Int
  title                 String?
  datePlayed            DateTime?
  status                String    @default("planned") // "planned" | "in_progress" | "complete"
  dmRawNotes            String    @default("")
  generatedSummary      String?
  keyEvents             Json      @default("[]")
  hooksForNext          Json      @default("[]")
  recapRead             Boolean   @default(false)
  spotifySessionPlaylist Json?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  campaign      Campaign             @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  party         Party?               @relation(fields: [partyId], references: [id])
  entityTouches SessionEntityTouch[]
  encounters    Encounter[]

  @@unique([campaignId, sessionNumber])
}

model SessionEntityTouch {
  id          String      @id @default(cuid())
  sessionId   String
  entityType  String
  entityId    String
  touchedAt   DateTime    @default(now())

  session     GameSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

// ─── NPCs ────────────────────────────────────────────────────────────────────

model NPC {
  id                 String    @id @default(cuid())
  campaignId         String
  name               String
  description        String    @default("")
  imageUrl           String?
  portraitUrl        String?
  portraitAssetId    String?
  tags               String[]  @default([])
  customFields       Json      @default("{}")
  pinned             Boolean   @default(false)
  dmOnlyNotes        String    @default("")
  role               String    @default("")
  appearance         String    @default("")
  personality        String    @default("")
  motivations        String    @default("")
  secrets            String    @default("")
  voiceNotes         String    @default("")
  statBlock          Json      @default("{}")
  status             String    @default("alive") // "alive" | "dead" | "missing" | "unknown"
  dispositionToParty String    @default("neutral")
  locationId         String?
  factionId          String?
  firstSessionId     String?
  lastSeenSessionId  String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?

  campaign       Campaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  location       Location?  @relation(fields: [locationId], references: [id])
  faction        Faction?   @relation(fields: [factionId], references: [id])
  portraitAsset  Asset?     @relation("NpcPortrait", fields: [portraitAssetId], references: [id])
}

// ─── Locations ───────────────────────────────────────────────────────────────

model Location {
  id               String    @id @default(cuid())
  campaignId       String
  name             String
  description      String    @default("")
  imageUrl         String?
  imageAssetId     String?
  tags             String[]  @default([])
  customFields     Json      @default("{}")
  pinned           Boolean   @default(false)
  dmOnlyNotes      String    @default("")
  type             String    @default("site") // "region" | "settlement" | "site" | "room"
  parentLocationId String?
  mapAssetId       String?
  ambience         Json?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  campaign         Campaign    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  parentLocation   Location?   @relation("LocationHierarchy", fields: [parentLocationId], references: [id])
  childLocations   Location[]  @relation("LocationHierarchy")
  npcs             NPC[]
  encounters       Encounter[]
  mapAsset         MapAsset?   @relation(fields: [mapAssetId], references: [id])
  imageAsset       Asset?      @relation("LocationImage", fields: [imageAssetId], references: [id])
  mapPins          MapPin[]
}

// ─── Items ───────────────────────────────────────────────────────────────────

model Item {
  id               String    @id @default(cuid())
  campaignId       String
  name             String
  description      String    @default("")
  imageUrl         String?
  imageAssetId     String?
  tags             String[]  @default([])
  customFields     Json      @default("{}")
  pinned           Boolean   @default(false)
  dmOnlyNotes      String    @default("")
  category         String    @default("")
  rarity           String    @default("common")
  mechanicalEffect String    @default("")
  currentOwnerType String    @default("unclaimed")
  currentOwnerId   String?
  originSessionId  String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  campaign    Campaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  imageAsset  Asset?     @relation("ItemImage", fields: [imageAssetId], references: [id])
}

// ─── Factions ────────────────────────────────────────────────────────────────

model Faction {
  id                    String    @id @default(cuid())
  campaignId            String
  name                  String
  description           String    @default("")
  imageUrl              String?
  tags                  String[]  @default([])
  customFields          Json      @default("{}")
  pinned                Boolean   @default(false)
  dmOnlyNotes           String    @default("")
  goals                 String    @default("")
  dispositionToParty    String    @default("neutral")
  headquartersLocationId String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  deletedAt             DateTime?

  campaign    Campaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  npcs        NPC[]
}

// ─── Encounters ──────────────────────────────────────────────────────────────

model Encounter {
  id            String    @id @default(cuid())
  campaignId    String
  sessionId     String?
  name          String
  description   String    @default("")
  imageUrl      String?
  tags          String[]  @default([])
  customFields  Json      @default("{}")
  pinned        Boolean   @default(false)
  dmOnlyNotes   String    @default("")
  type          String    @default("combat")
  difficulty    String    @default("medium")
  setup         String    @default("")
  tactics       String    @default("")
  twist         String    @default("")
  scalingNotes  String    @default("")
  participants  Json      @default("[]")
  locationId    String?
  mapAssetId    String?
  soundtrack    Json?
  outcome       String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  campaign    Campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  session     GameSession? @relation(fields: [sessionId], references: [id])
  location    Location?    @relation(fields: [locationId], references: [id])
}

// ─── Plot Threads ────────────────────────────────────────────────────────────

model PlotThread {
  id                  String    @id @default(cuid())
  campaignId          String
  title               String
  description         String    @default("")
  status              String    @default("active") // "active" | "resolved" | "dormant"
  relatedEntities     Json      @default("[]")
  lastTouchedSessionId String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  deletedAt           DateTime?

  campaign  Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
}

// ─── Relationships ───────────────────────────────────────────────────────────

model EntityRelationship {
  id               String    @id @default(cuid())
  campaignId       String
  entityAType      String
  entityAId        String
  entityBType      String
  entityBId        String
  relationshipType String
  notes            String    @default("")
  bidirectional    Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  campaign  Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
}

// ─── Assets (generic) ────────────────────────────────────────────────────────

model Asset {
  id                   String    @id @default(cuid())
  campaignId           String
  kind                 String    // "portrait_npc" | "item_art" | "location_art" | "map_battle" | "map_region" | "map_world" | "upload"
  storageKeyOriginal   String
  storageKeyThumb      String?
  storageKeyPreview    String?
  altText              String?
  width                Int?
  height               Int?
  source               String    @default("generated") // "generated" | "uploaded"
  generationJobId      String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  campaign        Campaign        @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  npcPortraits    NPC[]           @relation("NpcPortrait")
  locationImages  Location[]      @relation("LocationImage")
  itemImages      Item[]          @relation("ItemImage")
  mapAssets       MapAsset[]      @relation("MapAssetImage")
  artStylePreview ArtStylePreset? @relation("PresetPreview")
  pcPortraits     PlayerCharacter[] @relation("PcPortrait")
  pcSheets        PlayerCharacter[] @relation("PcSheet")
}

// ─── Art Style Presets ────────────────────────────────────────────────────────

model ArtStylePreset {
  id             String    @id @default(cuid())
  ownerUserId    String?
  name           String
  promptFragment String
  previewAssetId String?   @unique
  isBuiltin      Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  owner        User?  @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  previewAsset Asset? @relation("PresetPreview", fields: [previewAssetId], references: [id])
}

// ─── Map Assets ──────────────────────────────────────────────────────────────

model MapAsset {
  id                String    @id @default(cuid())
  campaignId        String
  kind              String    @default("battle") // "battle" | "region" | "world" | "other"
  title             String
  imageUrl          String?
  thumbnailUrl      String?
  imageAssetId      String?
  previewStorageKey String?
  altText           String?
  width             Int?
  height            Int?
  source            String    @default("generated") // "generated" | "uploaded"
  generationPrompt  String?
  grid              Json?
  linkedLocationId  String?
  linkedEncounterId String?
  generationJobId   String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  campaign    Campaign    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  imageAsset   Asset?     @relation("MapAssetImage", fields: [imageAssetId], references: [id])
  locations   Location[]
  pins        MapPin[]
}

// ─── Map Pins ─────────────────────────────────────────────────────────────────

model MapPin {
  id          String    @id @default(cuid())
  mapAssetId  String
  x           Float     // 0–1 normalised
  y           Float     // 0–1 normalised
  locationId  String?
  label       String    @default("")
  icon        String    @default("📍")
  revealed    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  mapAsset    MapAsset  @relation(fields: [mapAssetId], references: [id], onDelete: Cascade)
  location    Location? @relation(fields: [locationId], references: [id])
}

// ─── Generation jobs ─────────────────────────────────────────────────────────

model GenerationJob {
  id              String    @id @default(cuid())
  userId          String
  campaignId      String?
  provider        String    // "anthropic" | "evolink"
  kind            String
  status          String    @default("queued")
  input           Json      @default("{}")
  outputRef       Json      @default("{}")
  tokensOrUnits   Json      @default("{}")
  providerTaskId  String?
  costEstimate    Float?
  costActual      Float?
  error           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaign  Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
}

// ─── Custom generators ───────────────────────────────────────────────────────

model CustomGenerator {
  id                  String    @id @default(cuid())
  ownerUserId         String
  campaignId          String?
  name                String
  icon                String    @default("⚙️")
  description         String    @default("")
  outputEntityType    String    @default("freeform")
  promptTemplate      String    @default("")
  inputFields         Json      @default("[]")
  generatesImage      Boolean   @default(false)
  imagePromptTemplate String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  owner   User    @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
}

// ─── Player Characters ────────────────────────────────────────────────────────

model PlayerCharacter {
  id              String    @id @default(cuid())
  campaignId      String
  name            String
  playerName      String    @default("")
  race            String    @default("")
  class           String    @default("")
  playbook        String    @default("")
  subclass        String    @default("")
  level           Int       @default(1)
  background      String    @default("")
  alignment       String    @default("")
  appearance      String    @default("")
  backstory       String    @default("")
  notes           String    @default("")
  features        String    @default("")
  bonds           String    @default("")
  moves           String    @default("")
  abilityScores   Json      @default("{}")
  combatStats     Json      @default("{}")
  skills          Json      @default("{}")
  savingThrows    Json      @default("{}")
  equipment       Json      @default("[]")
  xp              Int       @default(0)
  sortOrder       Int       @default(0)
  portraitAssetId String?
  sheetAssetId    String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  campaign      Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  portraitAsset Asset?   @relation("PcPortrait", fields: [portraitAssetId], references: [id])
  sheetAsset    Asset?   @relation("PcSheet", fields: [sheetAssetId], references: [id])
}
